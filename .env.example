# Environment Variables for BedSched Backend

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/bedsched
SAI_CONNECT_ENDPOINT=https://www.saiconnect.app/api/getMemberDetailwithEventRegistrations
SAI_CONNECT_BEARER_TOKEN=replace-with-secret-token
SAI_CONNECT_DELEGATE_EVENT_ID=15
SAI_CONNECT_SEVADAL_EVENT_ID=14

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
# Defaults to true only when FRONTEND_URL is https://sssenclave.vercel.app.
REQUIRE_BOOKING_PHOTOS=false

# Authentication
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Reservation Settings
RESERVATION_TTL_HOURS=7

# AWS S3 Configuration (Required for photo uploads)
# Get these from your AWS administrator:
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIA...
AWS_SECRET_ACCESS_KEY=your-secret-access-key
S3_BUCKET_NAME=bedsched-photos

# Note: AWS credentials should have permissions for:
# - s3:PutObject (upload photos)
# - s3:GetObject (view photos)
# Only for the specified bucket
